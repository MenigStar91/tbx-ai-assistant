LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5:1.5b
REQUEST_TIMEOUT_SECONDS=45
VITE_API_URL=http://localhost:8000
SEED_DIRECTORY=data/uploads
UPLOAD_DIRECTORY=data/uploads
MYSQL_READ_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=tbx_assistant
MYSQL_READ_USER=tbx_readonly
MYSQL_READ_PASSWORD=tbx-readonly
MYSQL_WRITE_HOST=db
MYSQL_WRITE_USER=root
MYSQL_WRITE_PASSWORD=local-root-only
MYSQL_ROOT_PASSWORD=local-root-only
MYSQL_QUERY_TIMEOUT_MS=5000
MYSQL_MAX_QUERY_COST=100000
# Enable only for controlled benchmarks: EXPLAIN ANALYZE executes the query.
MYSQL_EXPLAIN_ANALYZE=false
REQUIRE_TIME_FILTER_TABLES=transaction
# Optional latest source date for deterministic relative periods in sample data.
# Leave empty for a live database to anchor relative dates to the current date.
DATA_MAX_DATE=2026-08-31
CONVERSATION_DB_PATH=data/runtime/conversations.db
